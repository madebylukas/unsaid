{
  "name": "unsaid",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Local visual speech recognition from a webcam.",
  "scripts": {
    "postinstall": "node scripts/setup-assets.mjs",
    "dev": "vite --host 127.0.0.1",
    "setup:vsr": "node scripts/setup-vsr.mjs",
    "vsr": "uv run --python cpython-3.12-macos-aarch64 --with-requirements backend/requirements.txt backend/server.py",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^0.10.22-rc.20250304"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.2",
    "vitest": "^3.2.4"
  }
}
